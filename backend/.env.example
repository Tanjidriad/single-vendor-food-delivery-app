NODE_ENV=development
PORT=3000
# Listen on all interfaces so phones on the same Wi‑Fi can connect (physical device testing).
HOST=0.0.0.0
API_PREFIX=api/v1

DATABASE_URL=postgresql://food_delivery:food_delivery@localhost:5432/food_delivery?schema=public

# Redis — required in production for rate-limiting, job queues, and cron locks
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Development: use * . Production: explicit comma-separated origins (required).
CORS_ORIGINS=*

# Maps — configure before enabling live tracking UI (deferred for launch prep).
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
RESTAURANT_LAT=23.8103
RESTAURANT_LNG=90.4125

ASSIGNMENT_TIMEOUT_SECONDS=45

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (Resend)
RESEND_API_KEY=

# SMS OTP (Twilio) — required for phone OTP in production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Error monitoring (Sentry) — strongly recommended for production
# Get DSN from: sentry.io → your project → Settings → Client Keys
SENTRY_DSN=

OTP_EXPIRY_MINUTES=10

# --- bKash Tokenized Checkout (sandbox — public test creds from developer guides) ---
# Docs: https://developer.bka.sh/docs/product-overview
# Sandbox wallets/PIN/OTP: https://arman.bd/bkash-sandbox-api/
PAYMENT_GATEWAY=bkash
BKASH_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
# WebView listens for this URL prefix after customer pays in bKash UI
BKASH_CALLBACK_URL=https://fooddelivery.app/payment/bkash/callback

# --- Pathao Courier ---
# Docs: https://developer.pathao.com/docs/courier
# Sandbox base URL (switch to https://api-hermes.pathao.com for production)
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Obtain store_id from GET /aladdin/api/v1/stores after authenticating
PATHAO_STORE_ID=
