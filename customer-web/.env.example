# Server-only Nest API, including its global prefix. Never expose this as NEXT_PUBLIC.
BACKEND_API_URL=https://api.example.com/api/v1

# Public customer website URL, used for canonical links, sitemap and payment callback.
NEXT_PUBLIC_SITE_URL=https://order.example.com

# Socket.IO host without the /realtime namespace.
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Optional privacy-conscious Google Analytics 4 measurement ID.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Public restaurant identity. Prefer slug; pin an id only when required.
NEXT_PUBLIC_RESTAURANT_SLUG=wasabi
# NEXT_PUBLIC_RESTAURANT_ID=

# Optional additional host for menu/banner images. Cloudinary is allowed already.
# NEXT_PUBLIC_IMAGE_ORIGIN=https://images.example.com
